{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-base",
            "description": "Visual Studio 開発環境のある Windows をターゲットにします。",
            "hidden": true,
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/bin/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "x64-debug",
            "displayName": "x64 Debug",
            "description": "Visual Studio 開発環境を使用して Windows (64 ビット) をターゲットにします。(Debug)",
            "inherits": "windows-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release",
            "description": "Visual Studio 開発環境を使用して Windows (64 ビット) をターゲットにします。(RelWithDebInfo)",
            "inherits": "windows-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "displayName": "Test",
            "inherits": "x64-release",
            "name": "Test",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Test",
                "TEST_DATA_SRC": "${sourceDir}/test/data"
            } 
        },
        {
            "displayName": "Test_Debug",
            "inherits": "x64-debug",
            "name": "Test_Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Test_Debug",
                "TEST_DATA_SRC": "${sourceDir}/test/data"
            }
        }
    ]
}