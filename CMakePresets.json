{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-base",
            "description": "Visual Studio / VSCode 共通のベース設定。Ninja (単一構成) を使う。",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/bin/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "x64-debug",
            "displayName": "x64 Debug",
            "description": "Windows (64bit) Debug ビルド。",
            "inherits": "windows-base",
            "architecture": { "value": "x64", "strategy": "external" },
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release",
            "description": "Windows (64bit) Release ビルド。",
            "inherits": "windows-base",
            "architecture": { "value": "x64", "strategy": "external" },
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "x64-debug-test",
            "displayName": "x64 Debug (テスト有効)",
            "description": "Debug ビルド + テストを CTest に登録する。",
            "inherits": "x64-debug",
            "cacheVariables": { "DIVISI_BUILD_TESTS": "ON" }
        },
        {
            "name": "x64-release-test",
            "displayName": "x64 Release (テスト有効)",
            "description": "Release ビルド + テストを CTest に登録する。",
            "inherits": "x64-release",
            "cacheVariables": { "DIVISI_BUILD_TESTS": "ON" }
        }
    ],
    "buildPresets": [
        { "name": "x64-debug",        "configurePreset": "x64-debug" },
        { "name": "x64-release",      "configurePreset": "x64-release" },
        { "name": "x64-debug-test",   "configurePreset": "x64-debug-test" },
        { "name": "x64-release-test", "configurePreset": "x64-release-test" }
    ],
    "testPresets": [
        {
            "name": "x64-debug-test",
            "displayName": "全テスト (Debug)",
            "configurePreset": "x64-debug-test",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        },
        {
            "name": "x64-release-test",
            "displayName": "全テスト (Release)",
            "configurePreset": "x64-release-test",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        }
    ]
}
